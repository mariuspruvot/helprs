{
  "repository_type": "monorepo",
  "parts": [
    {
      "part_id": "api",
      "project_type_id": "backend",
      "display_name": "FastAPI Backend",
      "root_path": "apps/api/",
      "language": "Python 3.12",
      "framework": "FastAPI",
      "entry_point": "src/helprs/main.py",
      "package_manager": "uv",
      "architecture_pattern": "Hybrid (simple modules + Clean Architecture)"
    },
    {
      "part_id": "web",
      "project_type_id": "web",
      "display_name": "React Frontend",
      "root_path": "apps/web/",
      "language": "TypeScript 6.0",
      "framework": "React 19",
      "entry_point": "src/app.tsx",
      "package_manager": "npm",
      "architecture_pattern": "Feature-based"
    },
    {
      "part_id": "infra",
      "project_type_id": "infra",
      "display_name": "Docker/Coolify Infrastructure",
      "root_path": "infra/",
      "language": "YAML/Dockerfile",
      "framework": "Docker + Coolify",
      "entry_point": "docker-compose.yml",
      "package_manager": "N/A",
      "architecture_pattern": "Multi-stage Docker builds"
    }
  ],
  "integration_points": [
    {
      "from": "web",
      "to": "api",
      "type": "REST + SSE",
      "details": "12 endpoints: auth, installations, sessions, streaming"
    },
    {
      "from": "api",
      "to": "GitHub API",
      "type": "REST (outbound) + Webhooks (inbound)",
      "details": "OAuth, org membership, PR diff fetch, 6 webhook event types"
    },
    {
      "from": "api",
      "to": "Anthropic Claude API",
      "type": "REST via Pydantic AI",
      "details": "Question generation, feedback, scoring (BYOK keys)"
    },
    {
      "from": "api",
      "to": "PostgreSQL",
      "type": "asyncpg (SQLAlchemy async)",
      "details": "10 tables, pool_size=20, max_overflow=10"
    }
  ]
}
