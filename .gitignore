# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/

# Node
node_modules/
npm-debug.log*

# Build outputs
apps/web/dist/
site/

# Environment
.env
.env.local
.env.*.local

# Local docker compose overrides (may contain secrets like GitHub App private keys for local dev)
docker-compose.override.yml
docker-compose.override.yaml

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Docker
*.log

# Testing
.coverage
htmlcov/
.pytest_cache/

# Playwright MCP debug artifacts
.playwright-mcp/

# Alembic
apps/api/alembic/versions/*.pyc

# BMAD planning & tooling (kept locally, not tracked in production repo)
_bmad/
_bmad-output/
# .claude/ is mostly local state (settings.local.json, reports) except for
# committed subagents. List exclusions explicitly — we can't unignore a file
# inside an excluded directory.
.claude/*
!.claude/agents/
.claude/reports/
