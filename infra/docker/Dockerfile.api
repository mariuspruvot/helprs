# Dev stage — volume mount overrides COPY src/ at runtime
FROM python:3.12-slim AS dev
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md alembic.ini ./
RUN uv sync
COPY src/ src/
COPY alembic/ alembic/

# Production stage
FROM python:3.12-slim AS production
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock README.md alembic.ini ./
RUN uv sync --no-dev
COPY src/ src/
COPY alembic/ alembic/
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
# --forwarded-allow-ips: uvicorn only trusts X-Forwarded-* from 127.0.0.1 by
# default. Behind Traefik every request would otherwise carry the proxy's IP,
# collapsing all rate limits into one global bucket — a single client could
# lock every user out of login. Safe here: the container is only reachable
# through the proxy.
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn helprs.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-4} --proxy-headers --forwarded-allow-ips='*'"]
