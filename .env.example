# Database
DATABASE_URL=postgresql+asyncpg://helprs:helprs@localhost:5432/helprs

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Anthropic (demo mode only — users provide their own via BYOK)
ANTHROPIC_API_KEY=

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=

# Frontend
VITE_API_URL=http://localhost:8000

# Public URL used by the backend to build user-facing links (e.g. PR-comment session links)
APP_BASE_URL=http://localhost:5173
